# Copiar a .env (ignorado por git). El CLI lo carga al arrancar; las variables ya definidas en el entorno tienen prioridad.
# Clave de la API alojada de NVIDIA NIM (https://build.nvidia.com): nvapi-...
NVIDIA_API_KEY=
# Solo si un rol de config/models.yaml usa esos proveedores:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# BD ConverData (OP-02): cadena ODBC. Con ella, catálogo, curación, inventario y auditoría viven en SQL Server (obligatoria en qa y prod);
# sin ella, en archivos bajo data/ (solo desarrollo). En el servidor: Trusted_Connection=yes con la gMSA, sin contraseña.
#   converdata db migrate        aplica db/converdata/*.sql
#   converdata catalog publish   importa un catálogo en archivos
# CONVERDATA_DB=SERVER=localhost\SQLEXPRESS;DATABASE=ConverData;Trusted_Connection=yes;TrustServerCertificate=yes

# Tarea programada del Builder (`converdata catalog build --db`): servidores del inventario a los que puede conectarse con
# la cuenta del servicio. Hosts o sufijos de dominio separados por coma. Obligatoria con CONVERDATA_ENV=qa|prod.
# CONVERDATA_BUILDER_HOSTS=.banco.local

# Pruebas contra un SQL Server real (crean y eliminan una BD ConverData_test_<aleatorio>); sin ella se omiten.
# CONVERDATA_TEST_DB=SERVER=localhost\SQLEXPRESS;Trusted_Connection=yes;TrustServerCertificate=yes

# Solo desarrollo local: abre sesión con tu cuenta de Windows.
# CONVERDATA_ALLOW_WINDOWS_AUTH=1
