  "cards": [
    {
      "dot": "cyan",
      "title": "Qué guarda",
      "items": [
        "Solo tablas normales de SQL Server 2016 o posterior",
        "Estructura y descripciones; nunca valores de datos de clientes",
        "Con historial y autor: object, column, inventory_server, item, business_rule y steward"
      ]
    },
    {
      "dot": "rose",
      "title": "Quién escribe",
      "items": [
        "converdata_app: todo menos modificar o borrar la auditoría",
        "converdata_builder: catálogo, entidades y linaje; no lee preguntas",
        "converdata_auditor lee; converdata_maintenance purga a los 180 días"
      ]
    },
    {
      "dot": "amber",
      "title": "Lo que no se dibuja",
      "items": [
        "catalog.server, catalog.catalog_version, knowledge.business_entity, curation.owners y dbo.schema_version",
        "Las tablas *_history de cada tabla con historial",
        "curation.vote → golden_discovery es lógica: no hay llave declarada"
      ]
    }
  ]
