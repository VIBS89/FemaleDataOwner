    {
      "id": "mw",
      "type": "security",
      "label": "SecurityMiddleware",
      "sublabel": "Origin, tamaño, cabeceras",
      "description": "Middleware ASGI más externo de la API. En POST/PUT/DELETE con cookie cd_session rechaza con 403 si Origin no es el del sitio (ni de CONVERDATA_CORS_ORIGINS ni el x-forwarded-host del proxy) y con 413 si el cuerpo pasa el tope. Añade las cabeceras de seguridad a todas las respuestas.",
      "sources": [
        {
          "path": "api/converdata_api/security.py",
          "line": 138,
          "end_line": 212
        }
      ]
    },
    {
      "id": "api",
      "type": "backend",
      "label": "ConverData-API",
      "sublabel": "/auth/login, current_session",
      "description": "Rutas FastAPI de main.py. /login y /auth/login validan el formulario, aplican LoginThrottle por login y por IP, prueban la credencial en cada servidor y crean la sesión. current_session saca el token de la cookie cd_session o de Authorization: Bearer; ninguna otra ruta acepta identidad ni credenciales.",
      "sources": [
        {
          "path": "api/converdata_api/main.py",
