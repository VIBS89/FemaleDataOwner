          "line": 314,
          "end_line": 322
        }
      ]
    },
    {
      "id": "vault",
      "type": "security",
      "label": "SessionVault",
      "sublabel": "en memoria, Fernet",
      "description": "Sesiones solo en memoria del proceso. Token de 256 bits; la contraseña se cifra con una clave Fernet generada al arrancar, así que reiniciar invalida todo. Caduca a las 8 h sin actividad (deslizante) o a las 12 h de vida; como máximo 5 sesiones por usuario.",
      "sources": [
        {
          "path": "api/converdata_api/vault.py",
