  "cards": [
    {
      "dot": "cyan",
      "title": "La regla de dependencias",
      "items": [
        "integración → aplicación → dominio ← infraestructura",
        "El dominio define puertos; la infraestructura los implementa",
        "tests/test_architecture.py la comprueba en src/converdata"
      ]
    },
    {
      "dot": "emerald",
      "title": "Por dónde empezar a leer",
      "items": [
        "Una pregunta: flows/discover.py y después discovery/engine.py",
        "Una ruta HTTP: api/converdata_api/main.py y runtime.py",
        "El catálogo: flows/catalog_build.py y builder/"
      ]
    },
    {
      "dot": "amber",
      "title": "Deuda conocida",
      "items": [
        "La API todavía llama al DiscoverFlow sin pasar por DiscoveryTools",
        "test_architecture.py no analiza api/converdata_api",
        "Detalle en capas-backend.md y en la wiki"
      ]
    }
